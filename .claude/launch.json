{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000",
        "--app-dir",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8010",
        "--app-dir",
        "backend"
      ],
      "port": 8010
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174,
      "env": {
        "VITE_PROXY_TARGET": "http://127.0.0.1:8010",
        "VITE_API_TIMEOUT_MS": "900000"
      }
    },
    {
      "name": "frontend-space",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5175"
      ],
      "port": 5175,
      "env": {
        "VITE_PROXY_TARGET": "https://dharmmalik-stock-scanner-backend.hf.space",
        "VITE_API_TIMEOUT_MS": "900000"
      }
    }
  ]
}