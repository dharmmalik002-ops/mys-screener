# Keep watchlists (per user request)
!backend/data/watchlists_state.json
!backend/data/watchlists_state_us.json

# Keep necessary startup seed chunks and static assets
!backend/data/*_seed_*.json
!backend/data/*universe*.json
!backend/data/bhavcopy_patch.json

# Local dev / runtime artifacts — never commit or deploy
.claude/worktrees/
frontend/public/api/
backend/data/free_snapshots_us*.json
backend/data/free_universe_us.json

# Mutual funds. Only mf_universe.json (the screener table) is tracked — it has
# to ship so a cold Space serves the Funds page immediately. The per-fund NAV
# and holdings blobs are rebuilt by scripts/build_mf_universe.py and cached
# lazily at runtime, and the portfolio lives in APP_STATE_DIR (like the trade
# journal), not in the repo.
backend/data/mf_details/
backend/data/mf_nav/
backend/data/mf_reference.json
backend/data/mf_portfolio.json

# Vercel CLI project linkage — Vercel advises against committing this.
frontend/.vercel/

# Local runtime caches — rebuilt on demand, never shipped (committed copies
# would look fresh after checkout and serve stale data)
backend/data/earnings_cache/
backend/data/bot_sleeve_cache.json
backend/data/bot_memory.json
