# Data and Cache
backend/data/chart_cache/
backend/data/breakout_bars/
# The bot's deep bar store: ~100 MB, rebuildable in ~10 min with
# scripts/build_deep_history.py. The derived artifacts it produces
# (bot_backtest.json, bot_signals.json) ARE committed, because the
# Space has no way to rebuild them.
backend/data/deep_history/
# Earnings announcement history: rebuildable in ~4 min with
# scripts/build_earnings_history.py, and only 484 of 1,581 symbols have
# analyst estimates at all, so it is raw material rather than a product.
backend/data/earnings_history/
# Quarterly standalone results from BSE, rebuilt by scripts/build_quarterly_results.py
backend/data/quarterly_results/
backend/data/bot_exit_sweep.json
backend/data/chart_cache_us/
backend/data/scan_history.json
backend/app/data/scan_history.json
backend/data/news_cache/
backend/data/*.json.gz
backend/data/*.lock
backend/data/free_snapshots.json
backend/data/free_snapshots_us.json
backend/data/industry_groups_cache.json
backend/data/industry_groups_cache_us.json
